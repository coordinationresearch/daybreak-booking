{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": false,
    "noEmit": false,
    "types": []
  },
  // The server side only: the client, the handler, and their types. The
  // booking page is bundled by esbuild (scripts/build.mjs).
  "include": ["src/index.ts"]
}
