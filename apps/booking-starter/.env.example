# Your deployment's HTTP actions address: the Deployment URL your Mac connected to, with .convex.cloud changed to .convex.site.
DAYBREAK_URL=https://your-deployment.convex.site
# A booking key from Daybreak's Settings › Booking › Website keys › New Key…. It's shown once.
DAYBREAK_BOOKING_KEY=

# Optional, both or neither: Cloudflare Turnstile, so bots can't book.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
